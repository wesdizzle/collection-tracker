{
  "name": "tracker",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "tsx scripts/dev.ts",
    "db:pull": "tsx scripts/d1_pull.ts",
    "d1:cost-guard": "tsx scripts/d1_cost_guard.ts",
    "d1:schema-drift": "tsx scripts/d1_schema_drift.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:ng && npm run test:node",
    "test:ng": "vitest run src --reporter tap",
    "test:node": "vitest run shared worker scripts --config vitest.node.config.ts --reporter tap",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "deploy": "tsx scripts/deploy.ts",
    "secrets:push": "tsx scripts/deploy.ts --put-secrets",
    "ci-check": "npm run lint && npm run format:check && npm run type-check && npm run d1:cost-guard && npm test && npm run build",
    "prepare": "husky"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@angular/service-worker": "^21.2.8",
    "@wesdizzle/app-kit": "git+https://github.com/wesdizzle/app-kit.git#v1.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.7",
    "@analogjs/vitest-angular": "^2.4.7",
    "@angular-devkit/build-angular": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@cloudflare/workers-types": "^4.20260412.1",
    "@emnapi/core": "1.9.2",
    "@emnapi/runtime": "1.9.2",
    "@emnapi/wasi-threads": "1.2.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/ui": "^4.1.4",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.81.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
